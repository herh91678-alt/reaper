-- Обновление времени последнего действия игрока (при движении мыши или нажатии клавиш)
UserInputService.InputBegan:Connect(function() config.LastInputTimestamp = tick() end)
UserInputService.InputChanged:Connect(function() config.LastInputTimestamp = tick() end)

-- Функция обновления UI в зависимости от статуса
local function updateButtonVisuals()
    if config.Enabled then
        toggleButton.Text = "🛡️ ANTI-AFK: ВКЛЮЧЕН"
        toggleButton.BackgroundColor3 = Color3.fromRGB(110, 60, 200) -- Фиолетовый
    else
        toggleButton.Text = "❌ ANTI-AFK: ВЫКЛЮЧЕН"
        toggleButton.BackgroundColor3 = Color3.fromRGB(35, 35, 42) -- Серый
        timerLabel.Text = "Время AFK: 00:00:00" -- Сброс таймера при выключении
    end
end

-- Главная функция переключения
local function toggleAntiAFK()
    config.Enabled = not config.Enabled
    updateButtonVisuals()
    
    -- Управление фоновыми процессами
    if config.Enabled then
        -- 1. Подключение Anti-Kick логики
        config.ActiveConnections.IdleEvent = localPlayer.Idled:Connect(function()
            pcall(function()
                VirtualUser:Button2Down(Vector2.new(0, 0), game.Workspace.CurrentCamera.CFrame)
                task.wait(0.5)
                VirtualUser:Button2Up(Vector2.new(0, 0), game.Workspace.CurrentCamera.CFrame)
                print("🛡️ [Anti-AFK]: Активность симулирована.")
            end)
        end)
        
        -- 2. Подключение цикла Таймера
        config.ActiveConnections.TimerLoop = RunService.RenderStepped:Connect(function()
            pcall(function()
                local afkSeconds = math.floor(tick() - config.LastInputTimestamp)
                
                -- Если время AFK отрицательное (например, из-за синхронизации часов), ставим 0
                if afkSeconds < 0 then afkSeconds = 0 end
                
                -- Форматирование времени ЧЧ:ММ:СС
                local hours = math.floor(afkSeconds / 3600)
                local minutes = math.floor((afkSeconds % 3600) / 60)
                local seconds = afkSeconds % 60
                
                timerLabel.Text = string.format("Время AFK: %02d:%02d:%02d", hours, minutes, seconds)
            end)
        end)
        
        print("✅ [AFK v1.5]: Система запущена.")
    else
        -- Безопасное отключение всех процессов
        if config.ActiveConnections.IdleEvent then config.ActiveConnections.IdleEvent:Disconnect(); config.ActiveConnections.IdleEvent = nil end
        if config.ActiveConnections.TimerLoop then config.ActiveConnections.TimerLoop:Disconnect(); config.ActiveConnections.TimerLoop = nil end
        
        print("⛔ [AFK v1.5]: Система остановлена.")
    end
end

-- Привязка к кнопке
toggleButton.MouseButton1Click:Connect(toggleAntiAFK)

-- Инициализация при запуске
updateButtonVisuals()
toggleAntiAFK() -- Запускаем ВКЛЮЧЕННЫМ по умолчанию
