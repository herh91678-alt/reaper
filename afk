        Settings[key] = not Settings[key]
        btn.BackgroundColor3 = Settings[key] and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
        btn.Text = Settings[key] and "ON" or "OFF"
        
        if key == "Aimbot" then
            updateFOV()
        end
        if key == "HighlightESP" then
            updateHighlightESP()
        end
        if key == "Fly" then
            startFly()
        end
        if key == "NoFall" then
            startNoFall()
        end
        if key == "Speed" then
            if Settings.Speed then
                startSpeed()
            end
        end
    end)
end

local function createInputBox(parent, text, key, minVal, maxVal)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -16, 0, 50)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    frame.BorderSizePixel = 0
    frame.Parent = parent

    local fCorner = Instance.new("UICorner")
    fCorner.CornerRadius = UDim.new(0, 6)
    fCorner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.Parent = frame

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(0.35, 0, 0, 30)
    input.Position = UDim2.new(0.6, 0, 0.5, -15)
    input.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    input.Text = tostring(Settings[key])
    input.TextColor3 = Color3.fromRGB(0, 255, 255)
    input.Font = Enum.Font.GothamBold
    input.TextSize = 12
    input.BorderSizePixel = 0
    input.Parent = frame

    local inputCorner = Instance.new("UICorner")
    inputCorner.CornerRadius = UDim.new(0, 6)
    inputCorner.Parent = input

    input.FocusLost:Connect(function()
        local newValue = tonumber(input.Text)
        if newValue then
            if maxVal then
                newValue = math.clamp(newValue, minVal, maxVal)
            else
                newValue = math.max(newValue, minVal)
            end
            Settings[key] = newValue
            input.Text = tostring(newValue)
        else
            input.Text = tostring(Settings[key])
        end
    end)
end

local function createSlider(parent, text, key, minVal, maxVal)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -16, 0, 60)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    frame.BorderSizePixel = 0
    frame.Parent = parent

    local fCorner = Instance.new("UICorner")
    fCorner.CornerRadius = UDim.new(0, 6)
    fCorner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 0, 30)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.Parent = frame

    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0.2, 0, 0, 30)
    valLabel.Position = UDim2.new(0.8, 0, 0, 0)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = tostring(Settings[key])
    valLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
    valLabel.TextSize = 12
    valLabel.Font = Enum.Font.GothamBold
    valLabel.Parent = frame

    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(1, -20, 0, 4)
    slider.Position = UDim2.new(0, 10, 0, 44)
    slider.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    slider.Parent = frame

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
    fill.Parent = slider

    local value = Settings[key]
    local dragging = false

    local function update()
        local t = (value - minVal) / (maxVal - minVal)
        local width = t * slider.AbsoluteSize.X
        fill.Size = UDim2.new(0, width, 1, 0)
        valLabel.Text = tostring(math.floor(value))
        Settings[key] = value
        if key == "AimbotFOV" and fovCircle then
            fovCircle.Radius = value
        end
    end

    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local x = math.clamp(input.Position.X - slider.AbsolutePosition.X, 0, slider.AbsoluteSize.X)
            value = minVal + (x / slider.AbsoluteSize.X) * (maxVal - minVal)
            update()
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local x = math.clamp(input.Position.X - slider.AbsolutePosition.X, 0, slider.AbsoluteSize.X)
            value = minVal + (x / slider.AbsoluteSize.X) * (maxVal - minVal)
            update()
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    update()
end

