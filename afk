-- [[ STEALTH HUB V24.0: ULTIMATE ALL-IN-ONE ]] --
local Players = game:GetService("Players"); local LP = Players.LocalPlayer
local RS = game:GetService("RunService"); local UIS = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera; local CoreGui = game:GetService("CoreGui")

getgenv().S = {Speed = 75, Fly = false}

-- 1. GUI (Интерфейс)
local G = Instance.new("ScreenGui", CoreGui); local F = Instance.new("Frame", G); F.Size = UDim2.new(0, 200, 0, 250); F.Position = UDim2.new(0.5, -100, 0.2, 0); F.Draggable = true; F.Active = true; F.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
local FB = Instance.new("TextButton", F); FB.Size = UDim2.new(0.9, 0, 0.2, 0); FB.Position = UDim2.new(0.05, 0, 0.05, 0); FB.Text = "Fly: OFF"
local IB = Instance.new("TextButton", F); IB.Size = UDim2.new(0.9, 0, 0.2, 0); IB.Position = UDim2.new(0.05, 0, 0.3, 0); IB.Text = "Interact (E)"
local SB = Instance.new("TextBox", F); SB.Size = UDim2.new(0.9, 0, 0.2, 0); SB.Position = UDim2.new(0.05, 0, 0.55, 0); SB.PlaceholderText = "Speed (75)"; SB.Text = "75"

-- 2. ОСНОВНЫЕ ФУНКЦИИ
local bv, bg, lastPos

local function Interact()
    local mouse = LP:GetMouse()
    if mouse.Target then
        local target = mouse.Target:FindFirstAncestorOfClass("Model") or mouse.Target
        local cd = target:FindFirstChildWhichIsA("ClickDetector", true)
        local pp = target:FindFirstChildWhichIsA("ProximityPrompt", true)
        if cd then fireclickdetector(cd)
        elseif pp then fireproximityprompt(pp) end
    end
end

-- 3. ЦИКЛ (FLY + ANTI-TELEPORT)
RS.Heartbeat:Connect(function()
    local char = LP.Character; if not char then return end
    local r = char:FindFirstChild("HumanoidRootPart"); local h = char:FindFirstChild("Humanoid")
    
    if h then h.WalkSpeed = S.Speed; h:ChangeState(Enum.HumanoidStateType.GettingUp) end
    
    -- Fly Logic
    if S.Fly and r then
        if not bv then 
            bv = Instance.new("BodyVelocity", r); bv.MaxForce = Vector3.new(9e9,9e9,9e9); bv.Velocity = Vector3.new(0,0,0)
            bg = Instance.new("BodyGyro", r); bg.MaxTorque = Vector3.new(9e9,9e9,9e9); bg.P = 10000 
        end
        local cam = Camera.CFrame
        local move = Vector3.new(0,0,0)
        if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + cam.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - cam.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - cam.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + cam.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0,1,0) end
        bv.Velocity = move * S.Speed
        bg.CFrame = cam
    elseif bv then bv:Destroy(); bg:Destroy(); bv=nil; bg=nil end
    
    -- Anti-Teleport
    if r then
        if not S.Fly then
            if lastPos and (r.Position - lastPos).Magnitude > 30 then r.CFrame = CFrame.new(lastPos)
            else lastPos = r.Position end
        else lastPos = r.Position end
    end
end)

-- 4. ПРИВЯЗКИ
FB.MouseButton1Click:Connect(function() S.Fly = not S.Fly; FB.Text = S.Fly and "Fly: ON" or "Fly: OFF" end)
IB.MouseButton1Click:Connect(Interact)
SB.FocusLost:Connect(function() S.Speed = tonumber(SB.Text) or 75 end)
UIS.InputBegan:Connect(function(i, g) if not g and i.KeyCode == Enum.KeyCode.E then Interact() end end)

print("STEALTH HUB V24.0 READY")
