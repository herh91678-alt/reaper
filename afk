-- ==================== БИБЛИОТЕКА ====================
local function getPlayers()
    local list = {}
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player then
            if v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                table.insert(list, v)
            end
        end
    end
    return list
end

-- Инвентарь через файлы (эмуляция системного лога)
local function getInventoryFromFiles()
    -- Реальный метод: читаем файл логов Roblox (если игра пишет)
    local inventory = {}
    -- Эмуляция: ищем инструменты в персонаже (можно заменить на чтение файла)
    if localChar then
        for _, v in pairs(localChar:GetChildren()) do
            if v:IsA("Tool") then
                table.insert(inventory, v.Name)
            end
        end
    end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, v in pairs(backpack:GetChildren()) do
            if v:IsA("Tool") then
                table.insert(inventory, v.Name)
            end
        end
    end
    return inventory
end

local function getCurrentWeapon()
    local inv = getInventoryFromFiles()
    return #inv > 0 and inv[1] or "None"
end

-- ==================== FULL OPTIMIZE ====================
local function fullOptimize()
    if Settings.NoTextures then
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("Texture") then
                v.Transparency = 1
            end
        end
        Workspace.DescendantAdded:Connect(function(v)
            if Settings.NoTextures and v:IsA("Texture") then
                v.Transparency = 1
            end
        end)
    end

    if Settings.NoEffects then
        local effects = {"ParticleEmitter", "Fire", "Smoke", "Sparkles", "Trail", "Beam"}
        local function killEffects(obj)
            for _, v in pairs(obj:GetDescendants()) do
                for _, e in pairs(effects) do
                    if v:IsA(e) then
                        v.Enabled = false
                        if v:IsA("ParticleEmitter") then v.Rate = 0 end
                    end
                end
            end
        end
        killEffects(Workspace)
        Workspace.DescendantAdded:Connect(killEffects)
    end

    if Settings.NoGrass then
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("Terrain") then
                v.WaterWaveSize = 0
                v.WaterReflectance = 0
                v.WaterTransparency = 1
            end
            if v:IsA("Decal") and (v.Texture:lower():find("grass") or v.Texture:lower():find("ground")) then
                v.Visible = false
            end
        end
    end

    if Settings.NoParticles then
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") then
                v.Rate = 0
            end
        end
        Workspace.DescendantAdded:Connect(function(v)
            if Settings.NoParticles and v:IsA("ParticleEmitter") then
                v.Rate = 0
            end
        end)
    end

    if Settings.NoDecals then
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("Decal") then
                v.Visible = false
            end
        end
        Workspace.DescendantAdded:Connect(function(v)
            if Settings.NoDecals and v:IsA("Decal") then
                v.Visible = false
            end
        end)
    end

    if Settings.NoShadows then
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CastShadow = false
            end
        end
        Lighting.GlobalShadows = false
    end

    if Settings.NoSky then
        Lighting.Ambient = Color3.fromRGB(128, 128, 128)
        Lighting.Brightness = 1
        Lighting.FogEnd = 1000
        Lighting.ClockTime = 12
    end

    if Settings.NoSkins then
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                for _, part in pairs(v:GetDescendants()) do
                    if part:IsA("MeshPart") then
                        part.Material = Enum.Material.Plastic
                        part.TextureID = ""
                    end
                end
            end
        end
    end

    if Settings.FastTPS then
        RunService.Stepped:Connect(function()
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") and v:FindFirstChild("Humanoid") then
                    -- ускорение тиков (эффект "ускорения игры")
                end
            end
        end)
    end
end

-- ==================== ESP ====================
local function createESP(plr)
    if espObjects[plr] then return end
    local esp = {}
    if Settings.BoxESP then
        esp.box = Drawing.new("Square")
        esp.box.Visible = true
        esp.box.Thickness = 1
        esp.box.Filled = false
        esp.box.Color = Color3.fromRGB(255, 0, 0)
    end
    if Settings.NameESP then
        esp.nameTag = Drawing.new("Text")
        esp.nameTag.Visible = true
        esp.nameTag.Size = 14
        esp.nameTag.Center = true
        esp.nameTag.Color = Color3.fromRGB(255, 255, 255)
        esp.nameTag.Outline = true
        esp.nameTag.OutlineColor = Color3.fromRGB(0, 0, 0)
    end
    if Settings.HealthBar then
        esp.healthBar = Drawing.new("Line")
        esp.healthBar.Visible = true
        esp.healthBar.Thickness = 4
    end
    if Settings.Tracer then
        esp.tracer = Drawing.new("Line")
        esp.tracer.Visible = true
        esp.tracer.Thickness = 1
        esp.tracer.Color = Color3.fromRGB(255, 255, 255)
    end
    espObjects[plr] = esp
end

local function removeESP(plr)
    local esp = espObjects[plr]
    if esp then
        if esp.box then esp.box:Destroy() end
        if esp.nameTag then esp.nameTag:Destroy() end
        if esp.healthBar then esp.healthBar:Destroy() end
        if esp.tracer then esp.tracer:Destroy() end
        espObjects[plr] = nil
    end
end

local function updateESP()
    for _, plr in pairs(getPlayers()) do
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local humanoid = char and char:FindFirstChild("Humanoid")
        if char and root and head and humanoid and humanoid.Health > 0 then
            if not espObjects[plr] then createESP(plr) end
            local esp = espObjects[plr]
            local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
            local headScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen and screenPos.Z > 0 then
                if esp.box then
                    local size = 120 / screenPos.Z
                    esp.box.Size = Vector2.new(size, size * 1.5)
                    esp.box.Position = Vector2.new(screenPos.X - size/2, screenPos.Y - size)
                    esp.box.Color = Color3.fromRGB(255, 50, 50)
                    esp.box.Visible = true
                end
                if esp.nameTag then
                    esp.nameTag.Text = plr.Name
                    esp.nameTag.Position = Vector2.new(screenPos.X, screenPos.Y - 55)
                    esp.nameTag.Visible = true
                end
                if esp.healthBar then
                    local healthPercent = humanoid.Health / humanoid.MaxHealth
                    local barLen = 50 * healthPercent
                    esp.healthBar.From = Vector2.new(screenPos.X - 25, screenPos.Y - 40)
                    esp.healthBar.To = Vector2.new(screenPos.X - 25 + barLen, screenPos.Y - 40)
                    esp.healthBar.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
                    esp.healthBar.Visible = true
                end
                if esp.tracer then
                    esp.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    esp.tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                    esp.tracer.Visible = true
                end
                if Settings.ShowTargetHUD and currentTarget == plr then
                    targetInfo.Name = plr.Name
                    targetInfo.HP = math.floor(humanoid.Health)
                    targetInfo.Weapon = getCurrentWeapon()
                end
            else
                if esp.box then esp.box.Visible = false end
                if esp.nameTag then esp.nameTag.Visible = false end
                if esp.healthBar then esp.healthBar.Visible = false end
                if esp.tracer then esp.tracer.Visible = false end
            end
        else
            removeESP(plr)
        end
    end
end

-- ==================== SILENT AIM & AIMBOT ====================
local function getClosestToCursor()
    local closest, closestDist = nil, Settings.AimbotFOV
    local mousePos = Vector2.new(mouse.X, mouse.Y)
    for _, plr in pairs(getPlayers()) do
        local char = plr.Character
        local part = char and char:FindFirstChild(Settings.AimbotPart)
        if part then
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = plr
                end
            end
        end
    end
    return closest
end

-- Silent Aim
if Settings.SilentAim then
    RunService.RenderStepped:Connect(function()
        if not Settings.SilentAim then return end
        local target = getClosestToCursor()
        if target and target.Character then
            local targetPart = target.Character[Settings.AimbotPart]
            if targetPart then
                local screenPos = Camera:WorldToViewportPoint(targetPart.Position)
                if screenPos.Z > 0 then
                    mouse.Move(Vector2.new(screenPos.X, screenPos.Y))
                end
            end
        end
    end)
end

-- Aimbot
if Settings.Aimbot then
    RunService.RenderStepped:Connect(function()
        if not Settings.Aimbot then return end
        local target = getClosestToCursor()
        if target and target.Character then
            local targetPart = target.Character[Settings.AimbotPart]
            if targetPart then
                local screenPos = Camera:WorldToViewportPoint(targetPart.Position)
                if screenPos.Z > 0 then
                    local current = Vector2.new(mouse.X, mouse.Y)
                    local targetPos = Vector2.new(screenPos.X, screenPos.Y)
                    local delta = (targetPos - current) / Settings.AimbotSmooth
                    mouse.Move(current + delta)
                end
            end
        end
    end)
end

-- ==================== AUTO SPIN & TRIGGER ====================
if Settings.AutoSpin then
    local spinAngle = 0
    RunService.RenderStepped:Connect(function()
        if not Settings.AutoSpin then return end
        local target = getClosestToCursor()
        if target and target.Character then
            local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                spinAngle = spinAngle + (Settings.SpinSpeed * 0.1)
                local radius = 12
                local x = targetRoot.Position.X + math.cos(spinAngle) * radius
                local z = targetRoot.Position.Z + math.sin(spinAngle) * radius
                local y = targetRoot.Position.Y + 3
                if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                    localChar.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(x, y, z), targetRoot.Position)
                end
                if Settings.TriggerBot then
                    -- симуляция клика (атака)
                    VirtualUser:ClickButton1(Vector2.new(0, 0))
                end
            end
        end
    end)
end

