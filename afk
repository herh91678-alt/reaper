    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
    fill.BorderSizePixel = 0
    fill.Parent = slider

    local value = Settings[key]
    local dragging = false

    local function update()
        local t = (value - minVal) / (maxVal - minVal)
        local width = t * slider.AbsoluteSize.X
        fill.Size = UDim2.new(0, width, 1, 0)
        valueLabel.Text = tostring(math.floor(value))
        Settings[key] = value
    end

    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local x = math.clamp(input.Position.X - slider.AbsolutePosition.X, 0, slider.AbsoluteSize.X)
            value = minVal + (x / slider.AbsoluteSize.X) * (maxVal - minVal)
            update()
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local x = math.clamp(input.Position.X - slider.AbsolutePosition.X, 0, slider.AbsoluteSize.X)
            value = minVal + (x / slider.AbsoluteSize.X) * (maxVal - minVal)
            update()
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    update()
end

