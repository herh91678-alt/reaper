local function ApplyMorph()
    if not char then
        print("[Морф] Нет персонажа для замены.")
        return
    end
    local InsertService = game:GetService("InsertService")
    print("[Морф] Загрузка модели...")
    local model = InsertService:LoadAsset(MORPH_ID)
    if not model or not model:IsA("Model") then
        print("[Морф] Не удалось загрузить модель.")
        return
    end
    -- Находим человеческий корень и человекообразного
    local newChar = model
    local newHum = newChar:FindFirstChildOfClass("Humanoid")
    if not newHum then
        -- Может быть внутри
        for _, child in pairs(newChar:GetChildren()) do
            newHum = child:FindFirstChildOfClass("Humanoid")
            if newHum then break end
        end
    end
    if not newHum then
        print("[Морф] Модель не содержит Humanoid.")
        model:Destroy()
        return
    end
    -- Отключаем коллизии и прочее
    for _, part in pairs(newChar:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.CanCollide = true
        end
    end
    -- Сохраняем позицию
    local root = char:FindFirstChild("HumanoidRootPart")
    local pos = root and root.Position or Vector3.new(0, 10, 0)
    -- Удаляем старого персонажа
    local oldChar = char
    oldChar:Destroy()
    -- Помещаем нового
    newChar.Parent = workspace
    -- Ставим на место
    local newRoot = newChar:FindFirstChild("HumanoidRootPart")
    if newRoot then
        newRoot.CFrame = CFrame.new(pos)
    end
    -- Применяем настройки
    char = newChar
    hum = newHum
    -- Переключаем камеру
    Camera.CameraSubject = hum
    Camera.CameraType = Enum.CameraType.Custom
    -- Применяем скорость и другие настройки
    originalSpeed = hum.WalkSpeed
    ApplySpeed()
    StartSpeedLoop()
    if GodModeEnabled then StartGodMode() end
    if NoclipEnabled then ApplyNoclip(); StartNoclipLoop() end
    if ShakerEnabled then
        task.wait(0.2)
        local tool = LP.Backpack:FindFirstChild("Jerk Off")
        if not tool then tool = createShakerTool(); setupShakerTool(tool) end
        hum:EquipTool(tool)
    end
    if DickEnabled then task.wait(0.2); CreateDick() end
    -- Если включён FreeCam – перезапускаем
    if FreeCamEnabled and not isSpecialPlace then
        task.wait(0.2)
        StartFreeCam()
    end
    print("[Морф] Морф успешно применён.")
end

-- ===== ФУНКЦИИ ДЛЯ ТРОЛЛИНГА =====
local function GetPlayerHRP(plr)
    if plr and plr.Character then
        return plr.Character:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function FlingPlayer(plr)
    local hrp = GetPlayerHRP(plr)
    if not hrp then return end
    local velocity = hrp.Velocity
    local lookDir = hrp.CFrame.LookVector
    local moveDir = velocity.Magnitude > 1 and velocity.Unit or lookDir
    local power = 80
    local ping = LP:GetNetworkPing() or 0
    local delay = math.clamp(0.05 + ping * 0.001, 0.05, 0.5)
    task.wait(delay)
    hrp.Velocity = moveDir * power + Vector3.new(0, 25, 0)
    hrp.RotVelocity = Vector3.zero
    print("[Троллинг] Флинг на " .. plr.Name .. " (задержка " .. delay .. " сек)")
end

local function TeleportToPlayer(plr)
    local hrp = GetPlayerHRP(plr)
    local myHrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and myHrp then
        myHrp.CFrame = hrp.CFrame + Vector3.new(0, 3, 0)
        print("[Троллинг] Телепорт к " .. plr.Name)
    end
end

-- ===== AIMBOT =====
local function GetClosestPlayerInFOV()
    local closest, closestDist = nil, math.huge
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local screenSize = Camera.ViewportSize
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local root = p.Character.HumanoidRootPart
            local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if not onScreen then continue end
            local dx = screenPos.X - screenSize.X / 2
            local dy = screenPos.Y - screenSize.Y / 2
            local distFromCenter = math.sqrt(dx * dx + dy * dy)
            local fovDeg = (distFromCenter / screenSize.X) * 90
            if fovDeg > FOV then continue end
            local d = (root.Position - myRoot.Position).Magnitude
            if d < closestDist then
                closestDist = d
                closest = p.Character
            end
        end
    end
    return closest
end

-- ===== ФИКС СКОРОСТИ =====
local function ApplySpeed()
    if not char or not hum then return end
    if originalSpeed == 16 and hum.WalkSpeed > 0 then originalSpeed = hum.WalkSpeed end
    if SpeedEnabled then
        hum.WalkSpeed = originalSpeed * speedMultiplier
    else
        hum.WalkSpeed = originalSpeed
    end
end

local function StartSpeedLoop()
    if speedLoop then speedLoop:Disconnect() end
    speedLoop = RS.RenderStepped:Connect(function()
        if SpeedEnabled and char and hum then
            if hum.WalkSpeed < originalSpeed * speedMultiplier * 0.9 or hum.WalkSpeed > originalSpeed * speedMultiplier * 1.1 then
                hum.WalkSpeed = originalSpeed * speedMultiplier
            end
        end
    end)
end

local function StopSpeedLoop()
    if speedLoop then speedLoop:Disconnect(); speedLoop = nil end
end

local function UpdateSpeed()
    ApplySpeed()
    if SpeedEnabled then StartSpeedLoop() else StopSpeedLoop() end
end

-- ===== GOD MODE =====
local function StartGodMode()
    if godModeTimer then godModeTimer:Disconnect() end
    if not char or not hum then return end
    godModeTimer = RS.Heartbeat:Connect(function()
        if not GodModeEnabled then return end
        if hum and hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
        if hum then
            hum.MaxHealth = 100
            if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
        end
    end)
end

local function StopGodMode()
    if godModeTimer then godModeTimer:Disconnect(); godModeTimer = nil end
end

local function ToggleGodMode(state)
    GodModeEnabled = state
    if state then StartGodMode() else StopGodMode() end
end

-- ===== NOCLIP =====
local function ApplyNoclip()
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not NoclipEnabled
        end
    end
end

local function StartNoclipLoop()
    if noclipLoop then noclipLoop:Disconnect() end
    noclipLoop = RS.RenderStepped:Connect(function()
        if NoclipEnabled and char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function StopNoclipLoop()
    if noclipLoop then noclipLoop:Disconnect(); noclipLoop = nil end
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

local function ToggleNoclip(state)
    NoclipEnabled = state
    if state then
        ApplyNoclip()
        StartNoclipLoop()
    else
        StopNoclipLoop()
    end
end

