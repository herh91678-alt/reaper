-- ===== FREE CAM =====
local function StartFreeCam()
    if isSpecialPlace then return end
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    freeCamRootPart = rootPart
    rootPart.Anchored = true

    local head = char:FindFirstChild("Head")
    local camPos = head and head.Position or rootPart.Position + Vector3.new(0, 1.5, 0)
    Camera.CFrame = CFrame.new(camPos)

    local x, y, z = Camera.CFrame:ToEulerAnglesYXZ()
    cameraRotation = Vector2.new(x, y)

    Camera.CameraType = Enum.CameraType.Scriptable
    UIS.MouseBehavior = Enum.MouseBehavior.LockCenter

    freeCamSavedPos = Camera.CFrame.Position

    if freeCamConnection then freeCamConnection:Disconnect() end
    freeCamConnection = RS.RenderStepped:Connect(function(dt)
        if not FreeCamEnabled then return end

        local delta = UIS:GetMouseDelta()
        cameraRotation = cameraRotation - Vector2.new(delta.Y * sensitivity, delta.X * sensitivity)
        cameraRotation = Vector2.new(math.clamp(cameraRotation.X, -1.5, 1.5), cameraRotation.Y)

        Camera.CFrame = CFrame.new(Camera.CFrame.Position) * CFrame.fromEulerAnglesYXZ(cameraRotation.X, cameraRotation.Y, 0)

        local moveDir = Vector3.new()
        if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir += Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir -= Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir -= Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir += Camera.CFrame.RightVector end

        if moveDir.Magnitude > 0 then
            Camera.CFrame = Camera.CFrame + (moveDir.Unit * flySpeed * dt)
        end

        freeCamSavedPos = Camera.CFrame.Position
    end)

    print("[FreeCam] Активирована от первого лица.")
end

local function StopFreeCam()
    if isSpecialPlace then return end
    if freeCamConnection then
        freeCamConnection:Disconnect()
        freeCamConnection = nil
    end

    UIS.MouseBehavior = Enum.MouseBehavior.Default

    if freeCamRootPart then
        freeCamRootPart.CFrame = Camera.CFrame
        freeCamRootPart.Anchored = false
        freeCamRootPart = nil
    end

    if char and hum then
        Camera.CameraSubject = hum
        Camera.CameraType = Enum.CameraType.Custom
    end

    print("[FreeCam] Деактивирована.")
end

local function TeleportToFreeCam()
    if isSpecialPlace then print("Free Cam недоступна в этом плейсе.") return end
    if not FreeCamEnabled then print("Сначала включите FreeCam.") return end
    if not freeCamSavedPos then print("Нет сохранённой позиции.") return end
    if not char then print("Персонаж не найден.") return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        root.CFrame = CFrame.new(freeCamSavedPos)
        print("Телепорт в точку камеры.")
    else
        print("Нет HumanoidRootPart.")
    end
end

local function ToggleFreeCam(state)
    if isSpecialPlace then
        print("Free Cam отключена в этом плейсе.")
        return
    end
    FreeCamEnabled = state
    if state then
        StartFreeCam()
    else
        StopFreeCam()
    end
end

