local function createShakerTool()
    local tool = Instance.new("Tool")
    tool.Name = "Jerk Off"
    tool.RequiresHandle = false
    tool.Parent = LP.Backpack
    return tool
end

local function forceShakerAnimation(id, startTime, endTime, trackId, speed)
    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    if shakerTracks[trackId] then shakerTracks[trackId]:Stop(); shakerTracks[trackId] = nil end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. id
    local track = humanoid:LoadAnimation(anim)
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = false
    shakerTracks[trackId] = track
    shakerConnections[trackId] = RS.RenderStepped:Connect(function()
        if not shakerIsPlaying then track:Stop(); return end
        if not track.IsPlaying or track.TimePosition >= endTime then
            track:Play()
            track.TimePosition = startTime
            track:AdjustSpeed(speed)
        end
    end)
    track:Play()
    track.TimePosition = startTime
    track:AdjustSpeed(speed)
end

local function startShaker()
    shakerIsPlaying = true
    forceShakerAnimation("72042024", 0.3, 0.8, 1, 3.5)
    forceShakerAnimation("168268306", 0.8, 1.1, 2, 4.0)
end

local function stopShaker()
    shakerIsPlaying = false
    for _, conn in pairs(shakerConnections) do conn:Disconnect() end
    shakerConnections = {}
    for _, track in pairs(shakerTracks) do track:Stop() end
    shakerTracks = {}
end

local function setupShakerTool(tool)
    tool.Equipped:Connect(startShaker)
    tool.Unequipped:Connect(stopShaker)
end

local function ToggleShaker(state)
    ShakerEnabled = state
    if state then
        local tool = LP.Backpack:FindFirstChild("Jerk Off")
        if not tool then tool = createShakerTool(); setupShakerTool(tool) end
        if LP.Character and LP.Character:FindFirstChild("Humanoid") then
            LP.Character.Humanoid:EquipTool(tool)
        end
    else
        stopShaker()
        local tool = LP.Backpack:FindFirstChild("Jerk Off")
        if tool then tool:Destroy() end
    end
end

